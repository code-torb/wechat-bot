FROM node:22-bookworm-slim

ENV NODE_ENV=production
WORKDIR /app

# QQ only needs JavaScript dependencies; do not run the repository's Husky or
# browser-download install hooks. No .env or login/session data enters the image.
COPY package.json ./
RUN npm install --omit=dev --ignore-scripts --no-audit --no-fund && npm cache clean --force
COPY cli.js ./
COPY src ./src

USER node
CMD ["node", "cli.js", "qq", "agent"]
