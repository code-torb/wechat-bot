FROM node:22-bookworm-slim AS web
WORKDIR /src
COPY apps/admin-web/package.json apps/admin-web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY apps/admin-web ./
RUN npm run build

FROM node:22-bookworm-slim AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential python3 \
    && rm -rf /var/lib/apt/lists/* \
    && npm ci --omit=dev --no-audit --no-fund \
    && (node -e "require('better-sqlite3')" || npm rebuild better-sqlite3 --foreground-scripts) \
    && npm cache clean --force

FROM node:22-bookworm-slim
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY cli.js ./
COPY src ./src
COPY --from=web /src/dist ./admin-dist
RUN useradd --uid 10001 --system mgmt
USER mgmt
ENV MANAGEMENT_DIST=/app/admin-dist
EXPOSE 6080
CMD ["node", "src/management/main.js"]
