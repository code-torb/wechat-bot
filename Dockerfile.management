FROM node:22-bookworm-slim AS web
WORKDIR /src
COPY apps/admin-web/package.json apps/admin-web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY apps/admin-web ./
RUN npm run build

FROM node:22-bookworm AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN --mount=type=cache,target=/root/.npm \
    PUPPETEER_SKIP_DOWNLOAD=1 npm ci --omit=dev --no-audit --no-fund

FROM node:22-bookworm-slim
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY cli.js ./
COPY src ./src
COPY --from=web /src/dist ./admin-dist
RUN node -e "new (require('better-sqlite3'))(':memory:').close(); require('argon2').hash('probe').catch(error => { console.error(error); process.exitCode = 1 })"
RUN useradd --uid 10001 --system mgmt
RUN mkdir -p /app/data && chown -R mgmt:mgmt /app/data
USER mgmt
ENV MANAGEMENT_DIST=/app/admin-dist
EXPOSE 6080
CMD ["node", "src/management/main.js"]
